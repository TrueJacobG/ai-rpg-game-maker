{
  "name": "ai-rpg-game-maker",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "format": "biome format --write .",
    "lint": "biome check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build -w apps/web",
    "deploy": "npm run build && npm run deploy -w apps/worker"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "typescript": "6.0.3"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
