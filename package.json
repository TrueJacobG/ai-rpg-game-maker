{
  "name": "ai-rpg-game-maker",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "format": "biome format --write .",
    "lint": "biome check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "node scripts/sync-story-images.mjs && npm run build -w apps/web",
    "deploy": "npm run build && npm run deploy -w apps/worker",
    "pack:check": "tsx packages/pack/src/main.ts check",
    "pack:import": "tsx packages/pack/src/main.ts import",
    "setup": "node scripts/setup.mjs",
    "test:scripts": "node --test scripts/"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "typescript": "6.0.3"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "description": "Open-source framework for running a tabletop RPG as the game master, on Cloudflare Workers",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TrueJacobG/ai-rpg-game-maker.git"
  },
  "keywords": [
    "rpg",
    "tabletop",
    "game-master",
    "cloudflare-workers",
    "ai"
  ]
}
